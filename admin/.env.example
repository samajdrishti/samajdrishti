# Web dashboard (admin/) — desktop back-office.
# Same Spring Boot backend as the mobile field app.
# Copy to .env for local dev:  copy .env.example .env   (Windows) / cp .env.example .env (macOS/Linux)
# Build-time default. In Docker the runtime $API_URL (config.js) wins — no rebuild needed.
VITE_API_URL=http://localhost:5000/api
