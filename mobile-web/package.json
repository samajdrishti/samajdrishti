{
  "name": "samaj-drishti-mobile-web",
  "private": true,
  "version": "1.0.0",
  "description": "Samaj Drishti field inspection mobile app (installable PWA)",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174 --host",
    "build": "vite build",
    "preview": "vite preview --port 5174 --host",
    "test": "vitest run",
    "test:ui": "vitest",
    "test:watch": "vitest watch",
    "lint": "eslint src --ext .jsx,.js --max-warnings=0",
    "lint:fix": "eslint src --ext .jsx,.js --fix",
    "format": "prettier --write src"
  },
  "dependencies": {
    "axios": "^1.5.0",
    "leaflet": "^1.9.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.15.0",
    "socket.io-client": "^4.7.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@vitejs/plugin-react": "^4.0.4",
    "eslint": "^8.52.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.0.0",
    "vite": "^4.4.0",
    "vitest": "^1.0.0"
  }
}
