# Mobile field app (mobile-web/) — installable PWA for officials.
# Same Spring Boot backend as the web dashboard.
# Copy to .env for local dev:  copy .env.example .env   (Windows) / cp .env.example .env (macOS/Linux)
# LAN/phone testing: set to http://<your-lan-ip>:5000/api  (e.g. http://192.168.1.5:5000/api)
# Build-time default. In Docker the runtime $API_URL (config.js) wins — no rebuild needed.
VITE_API_URL=http://localhost:5000/api
