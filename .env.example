# Copy to .env and fill in real values. docker compose reads this file automatically.

# Random 32+ char string, e.g.  openssl rand -hex 32
JWT_SECRET=
# Random string shared between the API and the AI engine, e.g.  openssl rand -hex 16
AI_ENGINE_API_KEY=
# PostgreSQL password for the postgres service
POSTGRES_PASSWORD=

# Optional overrides
POSTGRES_DB=samajdrishti
POSTGRES_USER=postgres
SEED_DEMO_DATA=true
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
GOOGLE_MAP_API=
GROQ_API_KEY=
# Public backend URL the BROWSERS call (written into config.js at container start).
# No rebuild needed to change it. Default suits `docker compose up` on one machine.
API_URL=http://localhost:5000/api
